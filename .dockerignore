# ─── Dependencies & build output (rebuilt inside the image) ───
node_modules
dist
dist-ssr

# ─── Version control & editor cruft ───
.git
.gitignore
.DS_Store
.vscode
.idea
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# ─── Local env & secrets (build gets VITE_API_URL via build arg) ───
.env
.env.*
*.local

# ─── Reference / "junk" you keep locally but don't want in the build ───
docs
scripts
Lighthouse_Reports
**/Lighthouse
*.md
!README.md

# ─── Tooling configs not needed at build time ───
netlify.toml
.prettierrc
eslint.config.mjs

# ─── Logs & misc ───
logs
*.log
npm-debug.log*
yarn-debug.log*
*.tgz
coverage
.eslintcache
